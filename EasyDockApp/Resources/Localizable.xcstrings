{
  "sourceLanguage": "en",
  "strings": {
    "Accessibility": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ năng (Accessibility)"
          }
        }
      }
    },
    "After you allow it in System Settings, macOS may ask to quit and reopen EasyDock.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi bạn cho phép trong System Settings, macOS có thể yêu cầu thoát và mở lại EasyDock."
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã cho phép"
          }
        }
      }
    },
    "Allow…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép…"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao diện"
          }
        }
      }
    },
    "Check Now": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra ngay"
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra cập nhật…"
          }
        }
      }
    },
    "Check for updates automatically": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động kiểm tra cập nhật"
          }
        }
      }
    },
    "Checks updates.dangkhoabach.vn once a day. Turning this off means updates only happen when you ask for them.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra updates.dangkhoabach.vn mỗi ngày một lần. Tắt đi thì chỉ cập nhật khi bạn yêu cầu."
          }
        }
      }
    },
    "Cleanup": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dọn dẹp"
          }
        }
      }
    },
    "Clipboard": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard"
          }
        }
      }
    },
    "Dark": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tối"
          }
        }
      }
    },
    "Dock & Windows": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock & Cửa sổ"
          }
        }
      }
    },
    "EasyDock needs permissions to work.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "EasyDock cần được cấp quyền để hoạt động."
          }
        }
      }
    },
    "General": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chung"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngôn ngữ"
          }
        }
      }
    },
    "Launch at Login": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động cùng hệ thống"
          }
        }
      }
    },
    "Lets EasyDock minimize apps from the Dock, switch windows and paste from the clipboard history.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép EasyDock thu nhỏ app từ Dock, chuyển cửa sổ và dán từ lịch sử clipboard."
          }
        }
      }
    },
    "Light": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sáng"
          }
        }
      }
    },
    "Permissions": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền"
          }
        }
      }
    },
    "Quit EasyDock": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoát EasyDock"
          }
        }
      }
    },
    "Screen Recording": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi màn hình (Screen Recording)"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt"
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt…"
          }
        }
      }
    },
    "Show EasyDock": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện EasyDock"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ thống"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao diện"
          }
        }
      }
    },
    "This part comes in a later version of EasyDock.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần này sẽ có trong một phiên bản sau của EasyDock."
          }
        }
      }
    },
    "Updates": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật"
          }
        }
      }
    },
    "Used only for window thumbnails in the switcher. Nothing is recorded or saved.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dùng để chụp ảnh thu nhỏ cửa sổ trong bộ chuyển cửa sổ. Không ghi lại hay lưu gì cả."
          }
        }
      }
    },
    "Waiting for your approval in System Settings › General › Login Items. Until then EasyDock won't start at login.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ bạn duyệt trong System Settings › General › Login Items. Trước khi duyệt, EasyDock sẽ không tự khởi động khi đăng nhập."
          }
        }
      }
    }
  },
  "version": "1.0"
}
