    "%@": {
      "extractionState": "stale",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ / %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ Allow EasyDock in System Settings › Privacy & Security › Files and Folders.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Hãy cho phép EasyDock trong Cài đặt Hệ thống › Quyền riêng tư & Bảo mật › Tệp và Thư mục."
          }
        }
      }
    },
    "%@ from the same maker is still installed and may use these": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cùng hãng vẫn còn cài và có thể đang dùng các tệp này"
          }
        }
      }
    },
    "%@ is a link or sits inside another app, so it isn't removed here.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ là một liên kết hoặc nằm bên trong một ứng dụng khác, nên không gỡ ở đây."
          }
        }
      }
    },
    "%@ is open. Quit it first, so it doesn't write its files back.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đang mở. Hãy thoát nó trước để nó không ghi lại các tệp của mình."
          }
        }
      }
    },
    "%@ is part of macOS or is EasyDock itself, so it isn't removed here.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ là một phần của macOS hoặc chính là EasyDock, nên không gỡ ở đây."
          }
        }
      }
    },
    "%@ macOS asks for permission the first time an app reads Desktop, Documents or Downloads — grant it in System Settings › Privacy & Security › Files and Folders.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS sẽ hỏi quyền lần đầu một ứng dụng đọc Desktop, Documents hoặc Downloads — hãy cho phép trong Cài đặt Hệ thống › Quyền riêng tư & Bảo mật › Tệp và Thư mục."
          }
        }
      }
    },
    "%@ remaining": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "còn %@"
          }
        }
      }
    },
    "%@ until full": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nữa là đầy"
          }
        }
      }
    },
    "%@ was removed": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gỡ %@"
