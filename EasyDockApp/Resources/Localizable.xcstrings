    "Drop an app here, or choose one": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thả một ứng dụng vào đây, hoặc chọn một ứng dụng"
          }
        }
      }
    },
    "EasyDock can't open its database": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "EasyDock không mở được cơ sở dữ liệu"
          }
        }
      }
    },
    "EasyDock lists the app and what it left in your Library (settings, caches, saved state), and moves the ones you keep ticked to the Trash.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "EasyDock liệt kê ứng dụng và những gì nó để lại trong Thư viện của bạn (cài đặt, bộ nhớ đệm, trạng thái đã lưu), rồi chuyển các mục bạn giữ dấu chọn vào Thùng rác."
          }
        }
      }
    },
    "EasyDock needs permissions to work.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "EasyDock cần được cấp quyền để hoạt động."
          }
        }
      }
    },
    "Ever": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mãi mãi"
          }
        }
      }
    },
    "Everything in Downloads was added more recently.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ trong Downloads đều mới được thêm gần đây."
          }
        }
      }
    },
    "Everything is moved to the Trash — except the Trash itself, which is emptied permanently.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ được chuyển vào Thùng rác — trừ chính Thùng rác, sẽ bị đổ vĩnh viễn."
          }
        }
      }
    },
    "Everything is moved to the Trash, never deleted outright, and you get a notification when a run finishes. The Trash itself can't be emptied on a schedule.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ được chuyển vào Thùng rác chứ không xóa thẳng, và bạn sẽ nhận thông báo khi dọn xong. Không thể tự động đổ Thùng rác theo lịch."
          }
        }
      }
    },
    "Everything selected goes to the Trash.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi mục đã chọn sẽ được chuyển vào Thùng rác."
