    "Taking the most while you're not using them: %@. Click to see them and quit what you don't need.": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chiếm nhiều nhất dù bạn không dùng: %@. Bấm để xem và thoát những app không cần."
          }
        }
      }
    },
    "Temperature": {
      "localizations": {
        "vi": {
          "stringUnit": {
