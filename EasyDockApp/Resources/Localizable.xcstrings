      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiến trình"
          }
        }
      }
    },
    "Put the window in front on a half, a quarter, a third or a sixth of its screen, fill the screen or nearly, center it, or send it to another display. Restore puts it back as it was before EasyDock moved it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt cửa sổ đang dùng vào nửa, 1/4, 1/3 hay 1/6 màn hình của nó, phóng đầy hay gần đầy màn hình, căn giữa, hoặc chuyển sang màn hình khác. Khôi phục đưa cửa sổ về như trước khi EasyDock dời nó."
          }
        }
      }
    },
    "Quality": {
      "localizations": {
        "vi": {
